# Postgres connection string (e.g. from Neon). Use the pooled connection
# string in serverless deployments (Vercel) to avoid exhausting the
# database's direct connection limit.
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Google Maps JavaScript API key (Places library) — used to verify property
# addresses on the lead-capture form. Restrict it to this site's domain(s)
# in the Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# BulkVS REST API — used server-side only to text lead-form submitters a
# thank-you confirmation. Never expose these to the client (no NEXT_PUBLIC_ prefix).
# Use the exact Basic Auth header value from your BulkVS portal (base64 of
# "username :password" — note BulkVS expects a space before the colon).
BULKVS_API_URL=https://portal.bulkvs.com/api/v1.0
BULKVS_BASIC_AUTH=YOUR_BULKVS_BASIC_AUTH_HEADER_VALUE
BULKVS_FROM_NUMBER=1XXXXXXXXXX

# Brevo SMTP — used server-side only to send the post-submission welcome
# email to the lead and the lead-notification email to the sales inbox.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=YOUR_BREVO_SMTP_LOGIN
BREVO_SMTP_KEY=YOUR_BREVO_SMTP_KEY
BREVO_SENDER_EMAIL=hello@example.com
LEAD_NOTIFICATION_EMAIL=sales@example.com
